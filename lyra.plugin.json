{
  "schema_version": 3,
  "plugin": {
    "name": "lyra-plugins",
    "version": "0.1.0"
  },
  "metrics": [
    {
      "name": "accessibility_jobs",
      "description": "Computes job accessibility scores for each spatial unit using road network analysis and employment data.",
      "entrypoint": "lyra_plugins.runners.accessibility_jobs:run",
      "inputs": {
        "location": {
          "kind": "location"
        },
        "patterns": {
          "kind": "batch",
          "max_items": 20,
          "label": true,
          "value": {
            "kind": "string",
            "min_length": 1,
            "max_length": 256
          }
        },
        "edge_weights": {
          "kind": "enum",
          "values": ["length", "travel_time"],
          "default": "length",
          "required": false
        },
        "max_weight": {
          "kind": "json_schema",
          "schema": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "default": 1000,
          "required": false
        },
        "network_type": {
          "kind": "enum",
          "values": ["drive", "walk"],
          "default": "drive",
          "required": false
        },
        "year": {
          "kind": "enum",
          "values": [2020, 2021, 2022, 2023, 2024, 2025],
          "default": 2025,
          "required": false
        },
        "month": {
          "kind": "enum",
          "values": [5, 11],
          "nullable": true,
          "default": null,
          "required": false
        }
      },
      "output": {
        "kind": "table",
        "batched_columns": [
          {
            "source": "patterns",
            "name": "jobs_{key}",
            "type": "number",
            "unit": "jobs",
            "description": "Job accessibility for {label}.",
            "nullable": false
          }
        ]
      }
    },
    {
      "name": "accessibility_services",
      "description": "Computes service accessibility scores for each spatial unit using road network analysis and amenity data.",
      "entrypoint": "lyra_plugins.runners.accessibility_services:run",
      "inputs": {
        "location": {
          "kind": "location"
        },
        "service_filters": {
          "kind": "batch",
          "max_items": 20,
          "label": true,
          "value": {
            "kind": "json_schema",
            "schema": {
              "type": "object",
              "required": ["amenities"],
              "properties": {
                "amenities": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "salud_hospital",
                      "salud_consultorio",
                      "salud_farmacia",
                      "recreativo_parque",
                      "recreativo_club",
                      "recreativo_cine",
                      "recreativo_otro",
                      "educacion_guarderia",
                      "educacion_preescolar",
                      "educacion_primaria",
                      "educacion_secundaria",
                      "educacion_media_superior",
                      "educacion_superior"
                    ]
                  },
                  "minItems": 1,
                  "maxItems": 13,
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            }
          }
        },
        "attraction_edge_weights": {
          "kind": "enum",
          "values": ["length", "travel_time"],
          "default": "length",
          "required": false
        },
        "attraction_max_weight": {
          "kind": "json_schema",
          "schema": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "default": 1000,
          "required": false
        },
        "accessibility_edge_weights": {
          "kind": "enum",
          "values": ["length", "travel_time"],
          "default": "length",
          "required": false
        },
        "accessibility_max_weight": {
          "kind": "json_schema",
          "schema": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "default": 1000,
          "required": false
        },
        "network_type": {
          "kind": "enum",
          "values": ["drive", "walk"],
          "default": "drive",
          "required": false
        },
        "year": {
          "kind": "enum",
          "values": [2020, 2021, 2022, 2023, 2024, 2025],
          "default": 2025,
          "required": false
        },
        "month": {
          "kind": "enum",
          "values": [5, 11],
          "nullable": true,
          "default": null,
          "required": false
        }
      },
      "output": {
        "kind": "table",
        "batched_columns": [
          {
            "source": "service_filters",
            "name": "accessibility_{key}",
            "type": "number",
            "unit": "ratio",
            "description": "Service accessibility for {label}.",
            "nullable": false
          }
        ]
      }
    },
    {
      "name": "accessibility_services_with_public_spaces",
      "description": "Computes service accessibility scores using caller-provided public-space features.",
      "entrypoint": "lyra_plugins.runners.accessibility_services_with_public_spaces:run",
      "inputs": {
        "location": {
          "kind": "location"
        },
        "public_spaces": {
          "kind": "location"
        },
        "service_filters": {
          "kind": "batch",
          "max_items": 20,
          "label": true,
          "value": {
            "kind": "json_schema",
            "schema": {
              "type": "object",
              "required": ["amenities"],
              "properties": {
                "amenities": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "salud_hospital",
                      "salud_consultorio",
                      "salud_farmacia",
                      "recreativo_parque",
                      "recreativo_club",
                      "recreativo_cine",
                      "recreativo_otro",
                      "educacion_guarderia",
                      "educacion_preescolar",
                      "educacion_primaria",
                      "educacion_secundaria",
                      "educacion_media_superior",
                      "educacion_superior"
                    ]
                  },
                  "minItems": 1,
                  "maxItems": 13,
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            }
          }
        },
        "attraction_edge_weights": {
          "kind": "enum",
          "values": ["length", "travel_time"],
          "default": "length",
          "required": false
        },
        "attraction_max_weight": {
          "kind": "json_schema",
          "schema": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "default": 1000,
          "required": false
        },
        "accessibility_edge_weights": {
          "kind": "enum",
          "values": ["length", "travel_time"],
          "default": "length",
          "required": false
        },
        "accessibility_max_weight": {
          "kind": "json_schema",
          "schema": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "default": 1000,
          "required": false
        },
        "network_type": {
          "kind": "enum",
          "values": ["drive", "walk"],
          "default": "drive",
          "required": false
        },
        "year": {
          "kind": "enum",
          "values": [2020, 2021, 2022, 2023, 2024, 2025],
          "default": 2025,
          "required": false
        },
        "month": {
          "kind": "enum",
          "values": [5, 11],
          "nullable": true,
          "default": null,
          "required": false
        }
      },
      "output": {
        "kind": "table",
        "batched_columns": [
          {
            "source": "service_filters",
            "name": "accessibility_{key}",
            "type": "number",
            "unit": "ratio",
            "description": "Service accessibility for {label}.",
            "nullable": false
          }
        ]
      }
    },
    {
      "name": "temperature",
      "description": "Average surface temperature in degrees Celsius, derived from Landsat 9 thermal band (Band 10).",
      "entrypoint": "lyra_plugins.runners.temperature:run",
      "inputs": {
        "location": {
          "kind": "location"
        },
        "year": {
          "kind": "enum",
          "values": [2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025]
        },
        "season": {
          "kind": "enum",
          "values": ["spring", "summer", "autumn", "winter"]
        }
      },
      "output": {
        "kind": "table",
        "columns": [
          {
            "name": "temperature_c",
            "type": "number",
            "unit": "degC",
            "description": "Average land surface temperature in degrees Celsius."
          }
        ]
      }
    },
    {
      "name": "temperature_raster",
      "description": "Surface temperature raster in degrees Celsius, derived from Landsat 9 thermal band (Band 10).",
      "entrypoint": "lyra_plugins.runners.temperature_raster:run",
      "inputs": {
        "bounds": {
          "kind": "bounds"
        },
        "year": {
          "kind": "enum",
          "values": [2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025]
        },
        "season": {
          "kind": "enum",
          "values": ["spring", "summer", "autumn", "winter"]
        },
        "crs": {
          "kind": "string",
          "default": "EPSG:4326",
          "required": false
        },
        "scale": {
          "kind": "integer",
          "minimum": 1,
          "default": 30,
          "required": false
        }
      },
      "output": {
        "kind": "file",
        "media_type": "image/tiff",
        "extensions": [".tif", ".tiff"]
      }
    },
    {
      "name": "tree_coverage",
      "description": "Tree canopy coverage fraction, derived from high-resolution aerial imagery.",
      "entrypoint": "lyra_plugins.runners.tree_coverage:run",
      "inputs": {
        "location": {
          "kind": "location"
        }
      },
      "output": {
        "kind": "table",
        "columns": [
          {
            "name": "tree_coverage_m2",
            "type": "number",
            "unit": "m2",
            "description": "Tree canopy area in square meters."
          }
        ]
      }
    },
    {
      "name": "tree_coverage_raster",
      "description": "Tree canopy coverage fraction raster, where each pixel is the fraction of its area covered by trees above the height threshold.",
      "entrypoint": "lyra_plugins.runners.tree_coverage_raster:run",
      "inputs": {
        "bounds": {
          "kind": "bounds"
        },
        "crs": {
          "kind": "string",
          "default": "EPSG:4326",
          "required": false
        },
        "scale": {
          "kind": "integer",
          "minimum": 1,
          "default": 10,
          "required": false
        },
        "min_tree_height": {
          "kind": "number",
          "minimum": 0,
          "default": 3,
          "required": false
        }
      },
      "output": {
        "kind": "file",
        "media_type": "image/tiff",
        "extensions": [".tif", ".tiff"]
      }
    },
    {
      "name": "urbanized_area",
      "description": "Computes urbanized built-up surface area in square metres for each spatial unit.",
      "entrypoint": "lyra_plugins.runners.urbanized_area:run",
      "inputs": {
        "location": {
          "kind": "location"
        }
      },
      "output": {
        "kind": "table",
        "columns": [
          {
            "name": "urbanized_area_m2",
            "type": "number",
            "unit": "m2",
            "description": "Urbanized built-up surface area in square meters."
          }
        ]
      }
    }
  ]
}
