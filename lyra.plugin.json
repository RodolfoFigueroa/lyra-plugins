      },
      "entrypoint": "lyra_plugins.runners.accessibility_services_with_public_spaces:run"
    },
    {
      "name": "temperature",
      "description": "Average surface temperature in degrees Celsius, derived from Landsat 9 thermal band (Band 10).",
      "spatial_inputs": {
        "location": "location"
      },
      "request_schema": {
        "type": "object",
        "required": ["location", "year", "season"],
        "properties": {
          "location": {},
          "year": {
            "type": "integer",
            "enum": [2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025]
          },
          "season": {
            "type": "string",
            "enum": ["spring", "summer", "autumn", "winter"]
          }
        },
        "additionalProperties": false
      },
      "output": {
        "kind": "table",
        "columns": [
          {
            "name": "temperature_c",
            "type": "number",
            "unit": "degC",
            "description": "Average land surface temperature in degrees Celsius."
          }
        ]
      },
      "execution": {
        "queue": "interactive"
      },
      "entrypoint": "lyra_plugins.runners.temperature:run"
    },
    {
      "name": "temperature_raster",
      "description": "Surface temperature raster in degrees Celsius, derived from Landsat 9 thermal band (Band 10).",
      "spatial_inputs": {
        "bounds": "bounds"
      },
      "request_schema": {
        "type": "object",
        "required": ["bounds", "year", "season"],
        "properties": {
          "bounds": {},
          "year": {
            "type": "integer",
            "enum": [2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025]
          },
          "season": {
            "type": "string",
            "enum": ["spring", "summer", "autumn", "winter"]
          },
          "crs": {
            "type": "string",
            "default": "EPSG:4326"
          },
          "scale": {
            "type": "integer",
            "minimum": 1,
            "default": 30
          }
        },
        "additionalProperties": false
      },
      "output": {
        "kind": "file",
        "media_type": "image/tiff",
        "extensions": [".tif", ".tiff"]
      },
      "execution": {
        "queue": "interactive"
      },
      "entrypoint": "lyra_plugins.runners.temperature_raster:run"
    },
    {
      "name": "tree_coverage",
      "description": "Tree canopy coverage fraction, derived from high-resolution aerial imagery.",
      "spatial_inputs": {
        "location": "location"
      },
      "request_schema": {
        "type": "object",
        "required": ["location"],
        "properties": {
          "location": {}
        },
        "additionalProperties": false
      },
      "output": {
        "kind": "table",
        "columns": [
          {
            "name": "tree_coverage_m2",
            "type": "number",
            "unit": "m2",
            "description": "Tree canopy area in square meters."
          }
        ]
      },
      "execution": {
        "queue": "interactive"
      },
      "entrypoint": "lyra_plugins.runners.tree_coverage:run"
    },
    {
      "name": "tree_coverage_raster",
      "description": "Tree canopy coverage fraction raster, where each pixel is the fraction of its area covered by trees above the height threshold.",
      "spatial_inputs": {
        "bounds": "bounds"
      },
      "request_schema": {
        "type": "object",
        "required": ["bounds"],
        "properties": {
          "bounds": {},
          "crs": {
            "type": "string",
            "default": "EPSG:4326"
          },
          "scale": {
            "type": "integer",
            "minimum": 1,
            "default": 10
          },
          "min_tree_height": {
            "type": "number",
            "minimum": 0,
            "default": 3
          }
        },
        "additionalProperties": false
      },
      "output": {
        "kind": "file",
        "media_type": "image/tiff",
        "extensions": [".tif", ".tiff"]
      },
      "execution": {
        "queue": "interactive"
      },
      "entrypoint": "lyra_plugins.runners.tree_coverage_raster:run"
    },
    {
