{
  "schema_version": 2,
  "plugin": {
    "name": "lyra-plugins",
    "version": "0.1.0"
  },
  "metrics": [
    {
      "name": "accessibility_jobs",
      "description": "Computes job accessibility scores for each spatial unit using road network analysis and employment data.",
      "spatial_inputs": {
        "location": "location"
      },
      "request_schema": {
        "type": "object",
        "required": ["location", "patterns"],
        "properties": {
          "location": {},
          "patterns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "value"],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                  "minLength": 1,
                  "maxLength": 64
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true
          },
          "edge_weights": {
            "type": "string",
            "enum": ["length", "travel_time"],
            "default": "length"
          },
          "max_weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 1000
          },
          "network_type": {
            "type": "string",
            "enum": ["drive", "walk"],
            "default": "drive"
          },
          "year": {
            "type": "integer",
            "enum": [2020, 2021, 2022, 2023, 2024, 2025],
            "default": 2025
          },
          "month": {
            "enum": [5, 11, null],
            "default": null
          }
        },
        "additionalProperties": false
      },
      "output": {
        "kind": "table",
        "columns": [],
        "batched_columns": [
          {
            "source": "patterns",
            "name_template": "jobs_{key}",
            "type": "number",
            "unit": "jobs",
            "description_template": "Job accessibility for {label}.",
            "nullable": false,
            "batching_reason": "Reuses the network graph and employment data across requested DENUE regex patterns."
          }
        ]
      },
      "execution": {
        "queue": "interactive"
      },
      "entrypoint": "lyra_plugins.runners.accessibility_jobs:run"
    },
    {
      "name": "accessibility_services",
      "description": "Computes service accessibility scores for each spatial unit using road network analysis and amenity data.",
      "spatial_inputs": {
        "location": "location"
      },
      "request_schema": {
        "type": "object",
        "required": ["location", "service_filters"],
        "properties": {
          "location": {},
          "service_filters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "value"],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                  "minLength": 1,
                  "maxLength": 64
                },
                "value": {
                  "type": "object",
                  "required": ["amenities"],
                  "properties": {
                    "amenities": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/amenity"
                      },
                      "minItems": 1,
                      "maxItems": 13,
                      "uniqueItems": true
                    }
                  },
                  "additionalProperties": false
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true
          },
          "attraction_edge_weights": {
            "type": "string",
            "enum": ["length", "travel_time"],
            "default": "length"
          },
          "attraction_max_weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 1000
          },
          "accessibility_edge_weights": {
            "type": "string",
            "enum": ["length", "travel_time"],
            "default": "length"
          },
          "accessibility_max_weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 1000
          },
          "network_type": {
            "type": "string",
            "enum": ["drive", "walk"],
            "default": "drive"
          },
          "year": {
            "type": "integer",
            "enum": [2020, 2021, 2022, 2023, 2024, 2025],
            "default": 2025
          },
          "month": {
            "enum": [5, 11, null],
            "default": null
          }
        },
        "additionalProperties": false,
        "$defs": {
          "amenity": {
            "type": "string",
            "enum": [
              "salud_hospital",
              "salud_consultorio",
              "salud_farmacia",
              "recreativo_parque",
              "recreativo_club",
              "recreativo_cine",
              "recreativo_otro",
              "educacion_guarderia",
              "educacion_preescolar",
              "educacion_primaria",
              "educacion_secundaria",
              "educacion_media_superior",
              "educacion_superior"
            ]
          }
        }
      },
      "output": {
        "kind": "table",
        "columns": [],
        "batched_columns": [
          {
            "source": "service_filters",
            "name_template": "accessibility_{key}",
            "type": "number",
            "unit": "ratio",
            "description_template": "Service accessibility for {label}.",
            "nullable": false,
            "batching_reason": "Reuses the network graph, census mesh, and amenity data across requested service filters."
          }
        ]
      },
      "execution": {
        "queue": "interactive"
      },
      "entrypoint": "lyra_plugins.runners.accessibility_services:run"
    },
